{
  "name": "vini-master-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vini-master-memory"
    }
  ],
  "workflows": [
    {
      "name": "vini-master-missions",
      "binding": "MISSIONS",
      "class_name": "MissionWorkflow"
    }
  ],
  "vars": {
    "CF_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "NVIDIA_MODEL": "nvidia/nemotron-3-ultra-550b-a55b",
    "MAX_DAILY_MISSIONS": "3"
  }
}